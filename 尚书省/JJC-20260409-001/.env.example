# 应用配置
ENVIRONMENT=development
DEBUG=True
APP_NAME=泰迪杯 B 题 - 财报智能问数助手
APP_VERSION=0.1.0

# 数据库配置
DATABASE_URL=mysql+pymysql://root:caiwu123@mysql:3306/caiwu_assistant
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis 配置
REDIS_URL=redis://redis:6379/0

# MinIO 配置
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=caiwu
MINIO_SECRET_KEY=caiwu123456
MINIO_BUCKET=pdf-storage
MINIO_SECURE=False

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_HOURS=24

# PDF 解析配置
PDF_MAX_FILE_SIZE_MB=200
PDF_MAX_PAGE_COUNT=500
PDF_ENABLE_CHUNKING=True
PDF_CHUNK_SIZE_PAGES=100
PDF_WORKER_CONCURRENCY=8

# NL2SQL 配置
NL2SQL_MODEL_NAME=codellama/CodeLlama-7b-hf
NL2SQL_LORA_R=16
NL2SQL_LORA_ALPHA=32
NL2SQL_MAX_SEQ_LENGTH=512

# RAG 配置
RAG_VECTOR_DB_PATH=./data/chroma_db
RAG_EMBEDDING_MODEL=bge-large-zh-v1.5
RAG_TOP_K_RESULTS=5

# 任务调度配置
TASK_MAX_CONCURRENT=5
TASK_MAX_QUEUE_SIZE=100
TASK_TIMEOUT_SECONDS=3600
TASK_RETRY_MAX_ATTEMPTS=3

# 数据质量配置
DATA_FAILURE_RATE_THRESHOLD=0.05
DATA_AUTO_PAUSE_ON_FAILURE=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
